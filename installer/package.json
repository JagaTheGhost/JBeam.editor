{
  "name": "jbeam-editor-installer",
  "version": "0.2.0-beta",
  "productName": "JBeam.editor-Setup",
  "description": "Custom Frameless Web Bootstrapper for JBeam.editor v0.2Beta",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.beamng.jbeameditor.setup",
    "productName": "JBeam.editor-Setup",
    "artifactName": "JBeam.editor-Setup-v0.2Beta.${ext}",
    "win": {
      "target": "portable",
      "icon": "assets/logo.png"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*"
    ]
  },
  "keywords": [
    "jbeam",
    "beamng",
    "installer",
    "bootstrapper"
  ],
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8"
  },
  "author": "JBeam Studio Team",
  "license": "MIT"
}
