{
  "name": "jbeam-studio",
  "version": "0.1.0",
  "type": "module",
  "description": "JBeam Studio - Hybrid 3D & Source Development Environment for BeamNG.drive",
  "author": "JBeam Studio Team",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run electron:dev",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:start": "electron .",
    "package:zip": "electron-builder --win zip",
    "package:dir": "electron-builder --win dir",
    "test": "node test/runner.js"
  },
  "build": {
    "appId": "com.beamng.jbeamstudio",
    "productName": "JBeam Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/jbeam.png"
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "vite": "^6.1.1",
    "wait-on": "^8.0.2"
  }
}
